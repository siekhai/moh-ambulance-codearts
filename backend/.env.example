# ──────────────────────────────────────────────────────────────────────────────
# MoH Ambulance Backend — Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ──────────────────────────────────────────────────────────────────────────────

# HTTP port the Express server listens on.
PORT=3000

# Google Maps Platform API key.
# Required for geocoding, reverse geocoding, directions, and distance matrix.
# Enable these APIs on the key in the Google Cloud Console:
#   - Geocoding API
#   - Directions API
#   - Distance Matrix API
#   - Maps Static API (optional, for route preview images)
# Restrict the key by HTTP referrer (server IP) and by API scope.
# See docs/GOOGLE_MAPS_KEY_MANAGEMENT.md for rotation strategy.
GOOGLE_MAPS_API_KEY=your-api-key-here
